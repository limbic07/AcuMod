{
  "name": "acumod",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "data:armor-menu-order": "node scripts/build-mhwi-armor-menu-order.mjs",
    "knowledge:audit": "node scripts/knowledge/audit-baseline.mjs",
    "knowledge:audit-licenses": "node scripts/knowledge/audit-source-licenses.mjs",
    "knowledge:fetch-mhw-db": "node scripts/knowledge/fetch-mhw-db-snapshot.mjs",
    "knowledge:fetch-mhworlddata": "node scripts/knowledge/fetch-mhworlddata-armor-map.mjs",
    "knowledge:build-mhwdata": "node scripts/knowledge/build-mhwdata-database.mjs",
    "knowledge:build-game-text-bridge": "node scripts/knowledge/build-local-game-text-bridge.mjs",
    "knowledge:build-dev": "npm.cmd run knowledge:build-mhwdata && node scripts/knowledge/build-dev-pack.mjs",
    "knowledge:build-modding-dev": "node scripts/knowledge/build-dev-pack.mjs --modding-only",
    "knowledge:package-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/knowledge/package-bundle.ps1",
    "knowledge:package-modding-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/knowledge/package-bundle.ps1 -ModdingOnly -OutputPath references/knowledge/release/acumod-modding-dev-15.23.zip",
    "knowledge:verify-dev": "node scripts/knowledge/verify-dev-pack.mjs",
    "knowledge:verify-question-bank": "node scripts/knowledge/verify-question-bank.mjs",
    "knowledge:verify-e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/knowledge/verify-e2e.ps1",
    "knowledge:verify-release": "node scripts/knowledge/audit-source-licenses.mjs --strict",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "markdown-it": "^14.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
