  "schemaVersion": 1,
  "sources": [
    {
      "title": "Monster Hunter World Modding Wiki - Weapon IDs",
      "url": "https://github.com/AniBullet/MonsterHunterWorldModding/wiki/Weapon-IDs",
      "note": "The weapon table identifies slg as the Slinger folder and lists slg001 as Slinger. Acumod combines that with the documented wp weapon root."
    },
    {
      "title": "MHW Voice Changer",
      "url": "https://github.com/NathanCruz98/MHWVoiceChanger",
      "license": "MIT",
      "note": "The MAIN table in MHWCharacterVoices.db maps the 20 female and 20 male character-creation voice numbers to exact nbnk file names."
    },
    {
      "title": "Camilla - Ciri armor and slinger replacement",
      "url": "https://www.nexusmods.com/monsterhunterworld/mods/2096",
      "note": "The original mod page identifies slg119_0000 as the slinger used with the Ciri armor model."
    },
    {
      "title": "Player Furious Rajang",
      "url": "https://www.nexusmods.com/monsterhunterworld/mods/3440",
      "note": "The mod's documented Geralt replacement layout uses pl118_0000, m_face/face004, hair403 and slg118_0000."
    },
    {
      "title": "Monster Hunter World Modding Wiki - Face IDs",
      "url": "https://github-wiki-see.page/m/Ezekial711/MonsterHunterWorldModding/wiki/Face-IDs",
      "note": "Documents the dedicated face slots for Ryu, Sakura, Geralt, Ciri, Bayek, Leon, Claire and Artemis. Face resources remain advisory only and are never moved automatically."
    },
    {
      "title": "Monster Hunter World Modding Wiki - Hairstyle IDs",
      "url": "https://github-wiki-see.page/m/Ezekial711/MonsterHunterWorldModding/wiki/Hairstyle-IDs",
      "note": "Documents the dedicated Geralt, Ciri, Leon and Claire hairstyle slots. Hairstyle resources remain advisory only and are never moved automatically."
    },
    {
      "title": "PlayStation Blog - Horizon Zero Dawn Aloy armor",
      "url": "https://blog.playstation.com/2018/02/27/monster-hunter-world-meets-horizon-zero-dawn-how-to-unlock-aloys-armor-and-bow/",
      "note": "Confirms the Aloy complete armor changes the hunter appearance. Its armor resource gender is intentionally preserved because no separate fixed face or hairstyle root is documented."
    },
    {
      "title": "Gala Suit Slinger",
      "url": "https://www.nexusmods.com/monsterhunterworld/mods/2298?tab=posts",
      "note": "The original mod page identifies slg078_0000 as the Gala Suit slinger model."
    },
    {
      "title": "Nim Outfit - Brigade armor and slinger replacement",
      "url": "https://www.nexusmods.com/monsterhunterworld/mods/1964",
      "note": "The original mod page uses pl036_0000 and slg036_0000 together for the Brigade outfit."
    },
    {
      "title": "Receptionist China Dress - Thermae and Oolong replacements",
      "url": "https://www.nexusmods.com/monsterhunterworld/mods/2061",
      "note": "The original mod page pairs pl106_0000 with slg106_0000 and pl127_0000 with slg127_0000."
    },
    {
      "title": "Harley Quinn - Beetle and Butterfly slinger resources",
      "url": "https://www.nexusmods.com/monsterhunterworld/mods/4317",
      "note": "The original mod page identifies slg019_0000 and slg057_0000 as slinger resources reused by the Beetle and Butterfly armor families."
    }
  ],
